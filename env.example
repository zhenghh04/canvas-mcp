# canvas-mcp configuration
#
# Copy to one of these locations (the first one found wins, and a real
# environment variable always beats a file):
#
#   $CANVAS_MCP_ENV_FILE        any path you like
#   ./.env                      current directory
#   ~/.config/canvas-mcp/.env   recommended — works from any directory
#
#   cp env.example ~/.config/canvas-mcp/.env && chmod 600 ~/.config/canvas-mcp/.env
#
# No quotes, no spaces around "=".

# ---------------------------------------------------------------- required --

# Your institution's Canvas. No trailing slash, and do NOT include /api/v1.
# Canvas Free for Teachers is https://canvas.instructure.com
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token.
# Shown exactly once; copy it immediately. This is equivalent to your password:
# it carries every permission you have, in every course you touch.
CANVAS_API_TOKEN=

# ------------------------------------------------------------- convenience --

# Used whenever a tool's course_id argument is omitted. Found in the course URL:
# https://yourschool.instructure.com/courses/12345  ->  12345
CANVAS_DEFAULT_COURSE_ID=

# Where downloaded files and student submissions are written.
# Treat this directory as FERPA-relevant.
# CANVAS_DOWNLOAD_DIR=./canvas-downloads

# ------------------------------------------------------------------ safety --

# Writes: create/edit assignments, pages, modules; post grades; announce.
# Default 1 (on). Set 0 for a strictly read-only server.
# CANVAS_ENABLE_WRITES=1

# Destructive: delete assignments/pages/modules, remove enrollments, raw
# POST/PUT/DELETE. Default 0 (off) — these tools are not even published.
# Turn on for a specific cleanup task, then turn it back off.
# CANVAS_ALLOW_DESTRUCTIVE=0

# Replace emails, login ids, and SIS ids with stable anon-<hash> values.
# Names are deliberately NOT redacted. Default 0.
# CANVAS_REDACT_PII=0

# ------------------------------------------------------ trim the tool list --

# Publish only these groups. Fewer tools = less context spent.
# Groups: diagnostics, courses, people, assignments, grading, content, communication
# CANVAS_TOOL_GROUPS=diagnostics,courses,assignments,grading

# Strict allowlist of tool names. Cannot bypass a tier gate.
# CANVAS_TOOLS=canvas_auth_status,canvas_list_students,canvas_get_gradebook

# Denylist, applied last.
# CANVAS_DISABLE_TOOLS=canvas_message_students

# ------------------------------------------------------ limits and tuning --

# CANVAS_TIMEOUT=30            seconds per API request
# CANVAS_UPLOAD_TIMEOUT=300    seconds for file uploads
# CANVAS_MAX_UPLOAD_MB=100     refuse larger local files
# CANVAS_PER_PAGE=100          Canvas page size
# CANVAS_MAX_PAGES=10          pagination cap; beyond it results are _truncated
# CANVAS_MAX_CHARS=20000       response size cap, with an explicit notice
# CANVAS_MAX_RETRIES=3         attempts on rate limits and 5xx
